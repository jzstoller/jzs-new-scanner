{
	"name": "jzs-simple-scanner2",
	"version": "1.3.9",
	"description": "Scan documents with auto corner detection and perspective correction.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npx tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build-and-copy": "./build-and-copy.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"scanner",
		"document-scanner",
		"image-processing",
		"perspective-correction"
	],
	"author": "Extski",
	"license": "OBSD",
	"devDependencies": {
		"@types/node": "^20.19.27",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"@vitest/ui": "^4.0.16",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"happy-dom": "^20.10.3",
		"jsdom": "^27.4.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"perspective-transform": "^1.1.3"
	}
}
